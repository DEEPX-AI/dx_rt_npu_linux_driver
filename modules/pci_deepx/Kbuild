# SPDX-License-Identifier: GPL-2.0
# DeepX Synopsys PCIe driver

ccflags-y += -I$(src)/include
ccflags-y += -I$(src)/../include

ccflags-y += $(CCFLAGS)

# DEEPX MODIFIED: newer GCC flags -Waddress-of-packed-member on MMIO register
# structs (intentionally __packed).  Suppress so kernel 4.4 gcc-wrapper.py does
# not treat this benign warning as a fatal error.
ccflags-y += -Wno-address-of-packed-member

# Always compile perf measurement code (runtime-gated via sysfs)
ccflags-y += -DDMA_PERF_MEASURE

ifneq ($(CONFIG_DX_AI_ACCEL_RT),)
ccflags-y += -DCONFIG_DX_AI_ACCEL_RT=1
endif

ifeq ($(BUILD_DEFAULT_DBG), log)
ccflags-y += -DDX_DEBUG_ENABLE
else ifeq ($(BUILD_DEFAULT_DBG), perf)
ccflags-y += -DDX_DEBUG_FS
else ifeq ($(BUILD_DEFAULT_DBG), debugfs)
ccflags-y += -DDX_DEBUG_FS
else ifeq ($(BUILD_DEFAULT_DBG), dump_desc)
ccflags-y += -DDUMP_DESC_TABLE
else ifeq ($(BUILD_DEFAULT_DBG), test)
ccflags-y += -DDX_DEBUG_FS
ccflags-y += -DDX_DMA_TEST
obj-m += test/dw_edma_kunit.o
else ifeq ($(BUILD_DEFAULT_DBG), all)
ccflags-y += -DDX_DEBUG_ENABLE
ccflags-y += -DDX_DEBUG_FS
ccflags-y += -DDUMP_DESC_TABLE
ifneq ($(CONFIG_RPI_BUILD),)
ccflags-y += -DRPI_DEBUG_BUILD=1
endif
endif

ifneq ($(CONFIG_RPI_BUILD),)
ccflags-y += -DRPI_BUILD=1
endif

dx_dma-y := dw-edma-pcie.o dw-edma-core.o dw-edma-v0-core.o \
		dw-edma-v0-debugfs.o dw-edma-thread.o dx_util.o \
		dx_cdev.o dx_sgdma_cdev.o dx_cdev_ctrl.o \
		dx_cdev_events.o dx_sgdma.o dw-edma-mem.o \
		dx_dma_sysfs.o dx_link_health.o

ifneq ($(filter -DRPI_DEBUG_BUILD=1,$(ccflags-y)),)
ccflags-y += -I$(src)/utils/rpi
endif

ifneq ($(CONFIG_DX_AI_ACCEL_RT),)
dx_dma-y += dx_message.o
endif

ifeq ($(CONFIG_DMA_VIRTUAL_CHANNELS),)
dx_dma-y += virt-dma.o
else
# Kernel provides virt-dma but 4.4 built-in virt-dma lacks vchan_tx_desc_free
# (added in mainline 4.7).  Compile the extension stub only when the symbol is
# absent from the kernel's Module.symvers.  On 5.x kernels it is already in
# vmlinux — compiling it would cause a "exported twice" MODPOST error.	//DEEPX MODIFIED
ifeq ($(shell grep -qw vchan_tx_desc_free $(objtree)/Module.symvers 2>/dev/null && echo y),)
dx_dma-y += dx_vchan_ext.o
endif
endif

obj-$(CONFIG_DX_AI_ACCEL_PCIE_DEEPX) += dx_dma.o

ifeq ($(BUILD_DEFAULT_DBG), test)
obj-m += test/dw_edma_kunit.o
endif
